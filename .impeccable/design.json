      "css": ".ds-label{display:grid;gap:.25rem;font-family:var(--font-body,Barlow,sans-serif);font-weight:600;font-size:.82rem;letter-spacing:.02em;color:var(--ink-muted,#aab6d3)}.ds-input{font:inherit;font-weight:400;font-size:1rem;color:var(--ink,#f3f6fc);background:var(--panel-raised,#172751);border:1px solid var(--rule-strong,#3a4f86);border-radius:2px;padding:0 .7rem;min-height:2.5rem;caret-color:var(--data,#39c6f0)}.ds-input::placeholder{color:var(--ink-faint,#8190b5)}.ds-input:hover{border-color:var(--ink-faint,#8190b5)}.ds-input:focus-visible{outline:2px solid var(--focus,#39c6f0);outline-offset:0;border-color:var(--focus,#39c6f0)}"
    },
