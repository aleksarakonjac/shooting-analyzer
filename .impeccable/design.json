      "css": ".ds-rail{display:flex;flex-direction:column;gap:2px;width:13rem;padding:1.25rem .75rem;background:var(--ground-deep,#070e22);border-right:1px solid var(--rule,#22335e)}.ds-rail-link{display:flex;align-items:center;min-height:2.5rem;padding:0 .75rem;color:var(--ink-muted,#aab6d3);text-decoration:none;font-family:var(--font-body,Barlow,sans-serif);font-weight:600;font-size:.9rem;border-radius:2px}.ds-rail-link:hover{background:var(--panel,#101c3b);color:var(--ink,#f3f6fc)}.ds-rail-link[aria-current=page]{background:var(--select-bg,#fff);color:var(--select-fg,#0b1530)}.ds-rail-link:focus-visible{outline:2px solid var(--focus,#39c6f0);outline-offset:2px}"
    },
    {
      "name": "Alignment Flag",
      "kind": "chip",
      "refersTo": "flag-proposed",
      "description": "Gold dashed edge, pennant and word = proposed; steel solid edge and check = confirmed.",
      "html": "<span class=\"ds-flag ds-flag--proposed\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 21V3m0 1h12l-3.5 4L18 12H6\"/></svg>Predloženo</span> <span class=\"ds-flag ds-flag--confirmed\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></svg>Potvrđeno</span>",
      "css": ".ds-flag{display:inline-flex;align-items:center;gap:.5rem;min-height:1.9rem;padding:0 .65rem 0 .5rem;font-family:var(--font-body,Barlow,sans-serif);font-weight:700;font-size:.82rem;border:1px solid;border-radius:2px}.ds-flag--proposed{color:var(--proposed,#f2c14e);border-color:var(--proposed,#f2c14e);border-style:dashed;background:var(--proposed-soft,rgb(242 193 78 / .14))}.ds-flag--confirmed{color:var(--ink,#f3f6fc);border-color:var(--rule-strong,#3a4f86);background:transparent}"
    },
    {
      "name": "Score Box",
      "kind": "card",
      "refersTo": "score-box-total",
      "description": "Label plus condensed numeral; the total inverts to the white score bug.",
      "html": "<div class=\"ds-plate ds-plate--score\"><span class=\"ds-plate-label\">Ukupno</span><span class=\"ds-plate-value\">841.1</span></div> <div class=\"ds-plate\"><span class=\"ds-plate-label\">Grupa</span><span class=\"ds-plate-value\">8.0</span></div>",
      "css": ".ds-plate{display:inline-grid;gap:2px;min-width:7.5rem;padding:.5rem .75rem;background:var(--panel-sunk,#0a1430);color:var(--ink,#f3f6fc);border:1px solid var(--rule-strong,#3a4f86);border-radius:2px}.ds-plate-label{font-family:var(--font-body,Barlow,sans-serif);font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-muted,#aab6d3)}.ds-plate-value{font-family:var(--font-display,'Big Shoulders','Arial Narrow',sans-serif);font-weight:800;font-size:clamp(1.8rem,2.6vw,2.6rem);line-height:1;font-variant-numeric:tabular-nums}.ds-plate--score{background:var(--select-bg,#fff);color:var(--select-fg,#0b1530);border-color:var(--select-bg,#fff)}.ds-plate--score .ds-plate-label{color:var(--select-muted,#3a4a72)}"
    },
    {
      "name": "Series Board Row",
      "kind": "custom",
      "refersTo": "board-row-current",
      "description": "Finals leaderboard row: index, score-band pips (10.0-10.4 as a ring), group, total and running sum; the current series is the white bar.",
      "html": "<div class=\"ds-board\"><button class=\"ds-row\"><span class=\"ds-idx\">2</span><span class=\"ds-pips\"><i class=\"ds-pip ds-pip--ten\"></i><i class=\"ds-pip\"></i><i class=\"ds-pip\"></i><i class=\"ds-pip ds-pip--nine\"></i><i class=\"ds-pip ds-pip--low\"></i></span><span class=\"ds-grp\">7.2 mm</span><span class=\"ds-tot\">105.4<small>Σ 209.9</small></span></button><button class=\"ds-row\" aria-current=\"true\"><span class=\"ds-idx\">3</span><span class=\"ds-pips\"><i class=\"ds-pip\"></i><i class=\"ds-pip ds-pip--ten\"></i><i class=\"ds-pip\"></i><i class=\"ds-pip ds-pip--nine\"></i><i class=\"ds-pip\"></i></span><span class=\"ds-grp\">8.0 mm</span><span class=\"ds-tot\">105.7<small>Σ 315.6</small></span></button></div>",
      "css": ".ds-board{background:var(--panel,#101c3b);width:30rem}.ds-row{width:100%;min-height:3rem;padding:0 1rem;display:grid;grid-template-columns:1.75rem minmax(0,1fr) 4.25rem 4.75rem;align-items:center;gap:.75rem;background:transparent;color:var(--ink,#f3f6fc);border:0;border-bottom:1px solid var(--rule,#22335e);font-family:var(--font-body,Barlow,sans-serif);text-align:left;cursor:pointer;transition:background .18s}.ds-row:hover{background:var(--panel-raised,#172751)}.ds-row:focus-visible{outline:2px solid var(--focus,#39c6f0);outline-offset:-2px}.ds-row[aria-current=true]{background:var(--select-bg,#fff);color:var(--select-fg,#0b1530)}.ds-idx{font-family:var(--font-display,'Big Shoulders',sans-serif);font-weight:800;font-size:1.15rem;color:var(--ink-faint,#8190b5)}.ds-row[aria-current=true] .ds-idx,.ds-row[aria-current=true] .ds-grp,.ds-row[aria-current=true] small{color:var(--select-muted,#3a4a72)}.ds-pips{display:flex;gap:3px}.ds-pip{display:inline-block;width:.55rem;height:.55rem;border-radius:50%;background:var(--pip-top,#39c6f0)}.ds-pip--ten{background:transparent;box-shadow:inset 0 0 0 2px var(--pip-ten,#2a8fb4)}.ds-pip--nine{background:var(--pip-nine,#5c6e9c)}.ds-row[aria-current=true] .ds-pip--nine{background:var(--select-pip,#8b98bb)}.ds-pip--low{background:var(--pip-low,#ff6b74)}.ds-grp{color:var(--ink-faint,#8190b5);font-size:.82rem;text-align:right}.ds-tot{display:grid;justify-items:end;line-height:1;gap:2px;font-family:var(--font-display,'Big Shoulders',sans-serif);font-weight:800;font-size:1.4rem;font-variant-numeric:tabular-nums}.ds-tot small{font-family:var(--font-body,Barlow,sans-serif);font-size:.72rem;font-weight:600;color:var(--ink-faint,#8190b5)}"
    },
    {
      "name": "Segmented Tabs",
      "kind": "nav",
      "refersTo": "seg-item-selected",
      "description": "Period and source switch; the selected item is the white bar.",
      "html": "<div class=\"ds-seg\"><button class=\"ds-seg-item\">Nedelja</button><button class=\"ds-seg-item\" aria-pressed=\"true\">Mesec</button><button class=\"ds-seg-item\">Godina</button></div>",
      "css": ".ds-seg{display:inline-flex;border:1px solid var(--rule-strong,#3a4f86);border-radius:2px;overflow:hidden;background:var(--panel-sunk,#0a1430)}.ds-seg-item{min-height:calc(2.5rem - 2px);padding:0 1rem;color:var(--ink-muted,#aab6d3);background:transparent;border:0;font-family:var(--font-body,Barlow,sans-serif);font-weight:600;font-size:.9rem;cursor:pointer;outline-offset:-2px}.ds-seg-item+.ds-seg-item{border-left:1px solid var(--rule,#22335e)}.ds-seg-item:hover{color:var(--ink,#f3f6fc);background:var(--panel-raised,#172751)}.ds-seg-item[aria-pressed=true]{background:var(--select-bg,#fff);color:var(--select-fg,#0b1530)}.ds-seg-item:focus-visible{outline:2px solid var(--focus,#39c6f0)}"
    },
    {
      "name": "Panel",
      "kind": "card",
      "refersTo": "panel-head",
      "description": "Grid panel: uppercase tracked head over a 1px rule, body scrolls on its own.",
      "html": "<section class=\"ds-panel\"><header class=\"ds-panel-head\"><h2>Serije</h2><span>Serija 3 · pogoci 21–30</span></header><div class=\"ds-panel-body\">Panel body</div></section>",
      "css": ".ds-panel{background:var(--panel,#101c3b);color:var(--ink,#f3f6fc);border:1px solid var(--rule,#22335e);font-family:var(--font-body,Barlow,sans-serif);width:24rem}.ds-panel-head{display:flex;align-items:center;gap:.75rem;min-height:2.5rem;padding:0 1rem;border-bottom:1px solid var(--rule,#22335e)}.ds-panel-head h2{margin:0;font-size:.82rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.ds-panel-head span{color:var(--ink-faint,#8190b5);font-size:.82rem}.ds-panel-body{padding:1rem}"
    }
  ],
  "narrative": {
    "northStar": "Finale na televiziji",
    "overview": "**Creative North Star: \"Finale na televiziji\"**\n\nA training reads like an ISSF finals broadcast. The ground is a deep navy board. Figures sit on it in white condensed numerals, and every colour does exactly one job. The interface is a working scoreboard, not a document. On desktop, the signed-in app is a fixed board: a rail on the left, a scoreboard strip across the top, and a grid of panels that fills the viewport. Each panel scrolls on its own and the page itself does not scroll. Density is high and deliberate. Figures are large and everything around them is small and quiet.\n\nThe signature is the current row. When the shooter picks a series or a shot, that row turns into a white bar with navy text. Every panel lights the same selection at the same moment: the series board row, the shot table row, the large white point on the timeline, the white marker on the heart-rate chart and the white dot in the drift view. Because white is reserved for that bar and for primary actions, the selection can always be read from across the room.\n\nThe world is flat and graphic. It uses square corners, 1px steel rules between panels and tonal navy steps for depth. Glow, glass, decorative gradients and a light theme are all rejected. It is dark only.",
    "keyCharacteristics": [
      "Deep navy ground with lighter navy panels separated by 1px steel rules (a grid gap of 1px showing the rule colour).",
      "White condensed numerals (Big Shoulders 800) for every score and total; Barlow for all UI text.",
      "One colour per job: cyan = data series, gold dashed + word = proposed, red = elimination or error, white bar = current selection.",
      "Shot pips banded by score, with the 10.0–10.4 band drawn as a ring rather than a filled dot.",
      "Near-square corners (2px), no decorative shadows. One soft shadow is reserved for floating popovers.",
      "Desktop: a fixed panel grid. Phone: one panel per tab with a bottom navigation bar."
    ],
    "rules": [
      {
        "name": "The One Job Rule",
        "body": "Cyan means data, gold means proposed, red means error or elimination, and white means selected. Never use a signal colour for decoration, and never give one colour two meanings.",
        "section": "colors"
      },
      {
        "name": "The Current Row Rule",
        "body": "A white bar with navy text means the current selection or the primary action. Every panel that shows the selected series or shot lights it at the same time.",
        "section": "colors"
      },
      {
        "name": "The Not Colour Alone Rule",
        "body": "State always carries a word and a form along with its colour: a dashed or solid edge, a pennant or check, a struck or dashed rule, or a ring or filled pip.",
        "section": "colors"
      },
      {
        "name": "The Figures Are Condensed Rule",
        "body": "Every score, total and count that a shooter compares is set in Big Shoulders 800. Every compared figure in tables and charts uses tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The Seven Steps Rule",
        "body": "Use only the seven ramp sizes and the plate clamp.",
        "section": "typography"
      },
      {
        "name": "The Flat Board Rule",
        "body": "Nothing resting on the board casts a shadow. Use no glow, glass or decorative gradient fills.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** set every compared figure in Big Shoulders 800 with tabular numerals.",
      "**Do** mark the current selection with the white bar and navy text (select-bg and select-fg) in every panel at once.",
      "**Do** pair gold with a dashed edge and a word whenever something is proposed, and show it in one place per screen.",
      "**Do** separate panels with the 1px rule gap. Keep depth to the navy tonal steps.",
      "**Do** draw the 10.0–10.4 band as a ring and keep the other bands as filled dots.",
      "**Do** keep chart colours in `CHART` in sync with tokens.css whenever a token changes.",
      "**Do** give phone controls 2.75rem and show one panel per tab."
    ],
    "donts": [
      "**Don't** add glow, glass, blur or decorative gradient fills.",
      "**Don't** use cyan, gold, red or white for decoration or for a second meaning.",
      "**Don't** signal state with colour alone.",
      "**Don't** round corners beyond 2px or put shadows on resting surfaces.",
      "**Don't** add a light theme. The board is dark only.",
      "**Don't** nest cards inside panels. Sections inside a panel are separated by rules."
    ]
  }
}