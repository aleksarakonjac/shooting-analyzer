      "css": ".ds-btn-danger{font-family:var(--font-body,Barlow,system-ui,sans-serif);font-weight:700;font-size:0.9rem;min-height:2.5rem;padding:0 1rem;color:var(--danger,#ff6b74);background:transparent;border:1px solid var(--danger,#ff6b74);border-radius:2px;cursor:pointer}.ds-btn-danger:hover{background:var(--danger-soft,rgb(255 107 116 / .14))}.ds-btn-danger:focus-visible{outline:2px solid var(--focus,#39c6f0);outline-offset:2px}"
