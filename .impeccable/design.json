    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "White bar with navy text; the primary action.",
      "html": "<button class=\"ds-btn\">Potvrdi poravnanje</button>",
      "css": ".ds-btn{font-family:var(--font-body,Barlow,system-ui,sans-serif);font-weight:700;font-size:0.9rem;letter-spacing:0.02em;min-height:2.5rem;padding:0 1rem;color:var(--select-fg,#0b1530);background:var(--select-bg,#fff);border:1px solid var(--select-bg,#fff);border-radius:2px;cursor:pointer;transition:background .18s cubic-bezier(.16,1,.3,1)}.ds-btn:hover{background:var(--select-hover,#d9e2f5);border-color:var(--select-hover,#d9e2f5)}.ds-btn:active{background:var(--select-active,#b9c7e6)}.ds-btn:focus-visible{outline:2px solid var(--focus,#39c6f0);outline-offset:2px}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Secondary action on the board.",
      "html": "<button class=\"ds-btn-quiet\">Izmeni</button>",
      "css": ".ds-btn-quiet{font-family:var(--font-body,Barlow,system-ui,sans-serif);font-weight:700;font-size:0.9rem;letter-spacing:0.02em;min-height:2.5rem;padding:0 1rem;color:var(--ink,#f3f6fc);background:transparent;border:1px solid var(--rule-strong,#3a4f86);border-radius:2px;cursor:pointer;transition:background .18s}.ds-btn-quiet:hover{background:var(--panel-raised,#172751);border-color:var(--ink-faint,#8190b5)}.ds-btn-quiet:focus-visible{outline:2px solid var(--focus,#39c6f0);outline-offset:2px}"
    },
