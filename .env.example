# Copy to .env.local (git-ignored). Values come from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Needed for the admin approval e-mail and its link (also used by the purge cron).
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL used in the e-mailed link, e.g. https://example.com (falls back to the Vercel production URL).
SITE_URL=
# Resend (https://resend.com): API key, the admin's address, and an optional verified sender.
RESEND_API_KEY=
ADMIN_EMAIL=
EMAIL_FROM=
